# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_here

# Database Configuration
DB_PATH=cineverse.db

# Email Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="CINEVERSE <your_email@gmail.com>"

# Mercado Pago Configuration
MP_ACCESS_TOKEN=your_mercado_pago_access_token
MP_PUBLIC_KEY=your_mercado_pago_public_key
MP_WEBHOOK_URL=http://localhost:5000/api/payments/webhook
FRONTEND_URL=http://localhost:5173
